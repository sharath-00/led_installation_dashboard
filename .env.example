# ==============================================================================
# Google Sheets Configuration
# ==============================================================================
# Path to your Google Service Account credentials JSON
# (Remember to share your Google Sheet with:
#  gateway-kpi-sync@kpi-analytics-511709.iam.gserviceaccount.com as Viewer)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Paste your full Google Sheet URL or Spreadsheet ID below:
GOOGLE_SHEET_URL_OR_ID=

# Optional: Leave blank to auto-detect "Overall till - ...", "... Lamp Installed", and "Sheet2" tabs
GOOGLE_OVERALL_WORKSHEET=
GOOGLE_DAILY_WORKSHEET=
GOOGLE_RAW_WORKSHEET=

# ==============================================================================
# Email / SMTP Configuration (Gmail defaults)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Display name & sender email address
SMTP_SENDER_NAME=LED Installation Analytics
SMTP_SENDER_EMAIL=

# For Gmail: enable 2-Step Verification and generate a 16-character App Password
# (Google Account -> Security -> App passwords)
SMTP_PASSWORD=

# Comma-separated list of recipient emails
EMAIL_RECIPIENTS=
EMAIL_CC=

# Optional custom subject template
EMAIL_SUBJECT_TEMPLATE=[LED Installation Report] {overall_total} Lamps Installed | Yesterday +{yesterday_total} ({yesterday_date})
